{{- /*
  Hugo's built-in sitemap, plus the About page.

  About sets build.list to "never" so it stays out of the post list, the
  feed and llms.txt's Posts. Hugo's sitemap ranges over the same page
  collections, so that also left About out of sitemap.xml, and search
  engines only found it by following the nav link. It is added back here.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $pages := where .Pages "Sitemap.Disable" "ne" true }}
  {{- with site.GetPage "/about" }}
    {{- if not (in $pages .) }}{{ $pages = $pages | append . }}{{ end }}
  {{- end }}
  {{- range $pages }}
    {{- if .Permalink }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
  </url>
    {{- end }}
  {{- end }}
</urlset>
