{{- /*
  The default sitemap is built from page collections. The About page is
  list:never so it stays out of the post list, the feed, and the 404's
  recent posts, which also drops it from that collection. Add it back here.
*/ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Data.Pages }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>{{ end }}
  </url>
  {{- end }}
  <url>
    <loc>{{ "about/" | absURL }}</loc>
  </url>
</urlset>
