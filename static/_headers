# Response headers for Cloudflare (Workers static assets and Pages both read
# this file from the build output). Hugo copies it from static/ to public/.
#
# Syntax: a URL pattern on its own line, then indented "Name: value" lines.
# When several patterns match a request, Cloudflare applies all of them.

# Everything under /static/ has a content hash in its filename (CSS, fonts,
# processed images), so a changed file gets a new URL and the old one can be
# cached forever.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every response.
#
# The site runs no JavaScript, so the CSP forbids it outright: even if markup
# were injected, a script would have nothing to run in. tests/ keeps pages
# free of inline scripts, handlers and styles so this stays true. JSON-LD
# blocks are data, not script, and CSP does not apply to them.
#
# data: in img-src is for one small image Bootstrap inlines in the CSS.
# form-action lists both Buttondown domains: the form posts to .com, and
# Chrome checks form-action on every redirect, so a hop through the old
# .email domain must not be blocked either.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; form-action 'self' https://buttondown.com https://buttondown.email; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
